{
  "name": "arsene-remix",
  "version": "0.1.0",
  "private": true,
  "description": "ARSÈNE REMIX web game and Capacitor iOS shell",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "cap:sync": "pnpm run build && cap sync ios && node scripts/verify-ios-bundle.mjs",
    "verify:ios-bundle": "node scripts/verify-ios-bundle.mjs",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0"
  },
  "packageManager": "pnpm@11.19.0"
}
